# ── Telegram (create a bot with @BotFather, then send /start to it: it replies with your chat id) ──
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=              # comma separated; these chats get every deal and the scan summary, and are bot admins
# TELEGRAM_ALLOWED_CHATS=      # extra chats allowed to /start the bot (clients, team); they can set their own filters
# TELEGRAM_ADMIN_IDS=          # extra chats allowed to /scan
# BOT_OPEN=false               # true = anyone who finds the bot can subscribe
# TELEGRAM_PHOTOS=true         # send the listing photo with the alert
# TELEGRAM_SUMMARY=            # false = never, always = after every scan (default: only when there are alerts or errors)

# ── Deal rules ──
DEAL_THRESHOLD=20              # % below the local market price per m² that counts as a deal
SUSPICIOUS_THRESHOLD=55        # deeper than this is held back as a likely data error (rent vs sale, wrong area)
MARKET_STAT=median             # median | trimmed | mean
MIN_COMPS=5                    # comparable listings needed before a listing is rated
GEO_RADIUS_KM=1.5              # "nearby" comparables (portals that publish coordinates); 2x is the wider ring
MAX_SPREAD=0.4                 # ignore comparable groups whose prices vary too much to have a meaningful average
SIZE_RANGE=0.6                 # comparables between 0.4x and 1.6x the living area
LOCAL_ONLY=true                # never fall back to a city-wide average when the location is known
COMPS_WINDOW_DAYS=90           # listings stay comparables this long after they were last seen
EXCLUDE_FLAGS=share,price_from,rent_to_own,auction   # never alert these (auction = starting bid, not a price)
# MIN_PRICE=0
# MAX_PRICE=0
# MIN_SCORE=0                  # 0-100; e.g. 60 = only strong deals
MAX_ALERTS_PER_SCAN=25
REALERT_DROP_PCT=3             # alert a known deal again when its price drops a further 3 %
DEFAULT_CURRENCY=EUR
AREA_UNIT=m2                   # m2 | sqft (display only)

# ── Schedule & scraping ──
SCAN_CRON=0 */3 * * *          # every 3 hours
# SCAN_TIMEZONE=Europe/Berlin
ENGINE=auto                    # auto (HTTP, then Chrome when needed) | http | browser
CONCURRENCY=3                  # sources scanned in parallel (pages of one site are always sequential)
PAGE_DELAY_MS=2500             # pause between requests to the same site
REQUEST_TIMEOUT_MS=30000
RESPECT_ROBOTS=true            # only set false with the site owner's permission
FETCH_DEAL_DETAILS=true        # open each deal's page to read the description (better red-flag checks)
# PROXY_URL=http://user:pass@host:port   # residential proxy for strict portals
# CHROME_PATH=                 # system Chrome / Chromium instead of Puppeteer's
# HEADLESS=true
# DEBUG_SCREENSHOTS=false
# HEALTH_PORT=8080
# DB_PATH=data/deals.db
# SOURCES_FILE=sources.json

# ── Other alert channels (optional) ──
# SLACK_WEBHOOK_URL=
# ALERT_WEBHOOK_URL=           # JSON for n8n / Make / Zapier / CRM / Google Sheets
# ALERT_WEBHOOK_SECRET=

# ── AI (optional: reads pages with no structured data, reviews deals for hidden catches) ──
GEMINI_API_KEY=                # https://aistudio.google.com/apikey
GROQ_API_KEY=                  # https://console.groq.com/keys (free, very fast)
NVIDIA_API_KEY=                # https://build.nvidia.com (free credits)
OPENROUTER_API_KEY=            # https://openrouter.ai/keys (":free" models)
# OLLAMA_BASE_URL=http://localhost:11434/v1
# AI_CHAIN=gemini:gemini-3.6-flash,gemini:gemini-3.5-flash,groq:llama-3.3-70b-versatile,openrouter:openrouter/free
AI_TIMEOUT_MS=10000            # per model, while another model is left to try
AI_TOTAL_BUDGET_MS=30000       # whole answer
AI_HEDGE_MS=6000               # start the next model in parallel if the current one is silent this long (0 = off)
AI_EXTRACT=true
AI_REVIEW=true
AI_REVIEW_MAX=10               # AI reviews per scan (cost cap)
